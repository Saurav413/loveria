generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  gender             String?
  nickname           String?
  partnerNickname    String?   @map("partner_nickname")
  relationshipDate   DateTime? @map("relationship_date") @db.Date
  partnerUserId      Int?      @map("partner_user_id")
  latitude           Float?
  longitude          Float?
  locationUpdatedAt  DateTime? @map("location_updated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  reminders          Reminder[]
  profilePhoto       ProfilePhoto?
  couplePhoto        CouplePhoto?
  pairingCodesOwned  PairingCode[] @relation("PairingOwner")
  pairingCodesJoined PairingCode[] @relation("PairingConnected")
  sharedDrawing      SharedDrawing?
  slideshowUploads   SlideshowPhoto[] @relation("SlideshowUploader")
  drawingEvents      DrawingEvent[]

  @@map("users")
}

model EmailVerification {
  id        String    @id
  email     String
  googleSub String    @map("google_sub")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("email_verifications")
}

model Reminder {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  reminderDate DateTime @map("reminder_date") @db.Date
  note         String
  isNotified   Boolean  @default(false) @map("is_notified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model ProfilePhoto {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile_photos")
}

model CouplePhoto {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("couple_photos")
}

model PairingCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  ownerUserId     Int       @map("owner_user_id")
  connectedUserId Int?      @map("connected_user_id")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  connectedAt     DateTime? @map("connected_at")
  owner           User      @relation("PairingOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  connected       User?     @relation("PairingConnected", fields: [connectedUserId], references: [id], onDelete: SetNull)

  @@map("pairing_codes")
}

model SharedDrawing {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shared_drawings")
}

model SlideshowPhoto {
  id         Int      @id @default(autoincrement())
  pairUserA  Int      @map("pair_user_a")
  pairUserB  Int      @map("pair_user_b")
  uploadedBy Int      @map("uploaded_by")
  caption    String?
  url        String
  createdAt  DateTime @default(now()) @map("created_at")
  uploader   User     @relation("SlideshowUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([pairUserA, pairUserB, createdAt])
  @@map("shared_slideshow_photos")
}

model DrawingEvent {
  id         BigInt   @id @default(autoincrement())
  pairUserA  Int      @map("pair_user_a")
  pairUserB  Int      @map("pair_user_b")
  fromUserId Int      @map("from_user_id")
  eventType  String   @map("event_type")
  payload    String?
  createdAt  DateTime @default(now()) @map("created_at")
  fromUser   User     @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([pairUserA, pairUserB, id])
  @@map("drawing_events")
}
